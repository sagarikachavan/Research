{
  "model": {
    "llm_name": "Qwen/Qwen3-14B",
    "trust_remote_code": true,
    "load_in_4bit": true,
    "use_lora": true,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "lora_target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "torch_dtype": "bfloat16",
    "text_embedding_model": "all-MiniLM-L6-v2",
    "gnn_hidden_dim": 256,
    "gnn_out_dim": 128,
    "gnn_type": "gcn",
    "use_gat": false,
    "graph_token_count": 4,
    "pooling_strategy": "hybrid"
  },
  "training": {
    "num_supervised_epochs": 16,
    "num_grpo_epochs": 15,
    "batch_size": 1,
    "learning_rate": 5e-5,
    "gnn_learning_rate": 5e-6,
    "projector_learning_rate": 5e-6,
    "drift_guard_weight": 0.02,
    "weight_decay": 0.02,
    "max_grad_norm": 1.0,
    "num_warmup_steps": 500,
    "num_generations_per_sample": 4,
    "clip_eps": 0.2,
    "generate_max_new_tokens": 768,
    "generate_temperature": 0.8,
    "grpo_generate_temperature": 1.1,
    "grpo_reward_std_epsilon": 1e-6,
    "generate_top_p": 0.95,
    "validation_split": 0.1,
    "patience": 8,
    "max_seq_length": 1024,
    "step_loss_weight": 2.0,
    "mcp_loss_weight": 1.5,
    "rl_aux_supervised_weight": 0.15,
    "prompt_style": "compact",
    "step_class_weighting": true,
    "step_class_weight_power": 0.5,
    "max_step_class_weight": 5.0,
    "use_weighted_sampler": true,
    "sampler_power": 1.5,
    "selection_step_weight": 0.85,
    "selection_mcp_weight": 0.15,
    "selection_both_exact_weight": 0.0,
    "use_curriculum_learning": false,
    "curriculum_stages": 3,
    "data_quality_threshold": 0.7,
    "use_data_filtering": false
  },
  "paths": {
    "data_dir": "data",
    "embeddings_dir": "embeddings_data",
    "output_dir": "checkpoints",
    "log_dir": "logs"
  }
}
