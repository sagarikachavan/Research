{
  "model": {
    "llm_name": "Qwen/Qwen2.5-7B-Instruct",
    "trust_remote_code": true,
    "load_in_4bit": true,
    "use_lora": true,
    "lora_r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "lora_target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "torch_dtype": "float16",
    "pooling_strategy": "mean"
  },
  "training": {
    "num_supervised_epochs": 5,
    "num_grpo_epochs": 3,
    "batch_size": 1,
    "gradient_accumulation_steps": 16,
    "learning_rate": 2e-4,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "num_warmup_steps": 200,
    "num_generations_per_sample": 4,
    "clip_eps": 0.2,
    "generate_max_new_tokens": 256,
    "generate_temperature": 0.7,
    "generate_top_p": 0.9,
    "validation_split": 0.1,
    "patience": 5,
    "max_seq_length": 1024,
    "step_loss_weight": 4.0,
    "mcp_loss_weight": 1.0,
    "explanation_loss_weight": 0.0,
    "rl_aux_supervised_weight": 0.3,
    "prompt_style": "full",
    "step_class_weighting": true,
    "step_class_weight_power": 0.8,
    "max_step_class_weight": 8.0,
    "mcp_class_weighting": true,
    "mcp_class_weight_power": 0.5,
    "max_mcp_class_weight": 6.0,
    "use_weighted_sampler": true,
    "sampler_power": 1.0,
    "selection_step_weight": 0.9,
    "selection_mcp_weight": 0.1,
    "selection_both_exact_weight": 0.05
  },
  "paths": {
    "data_dir": "data",
    "output_dir": "/tmp/stepmodel_checkpoints",
    "log_dir": "/tmp/stepmodel_logs"
  }
}
