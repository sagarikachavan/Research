# ---------------------------------------------------------------------------
# stepmodel-final-v2 .gitignore
#
# POLICY: results and trained weights ARE tracked. Checkpoints (Stage 1/2/3),
# every file under output/ (metrics JSON, prediction CSVs, LLM-judge reports,
# comparison tables, plots) and run logs are all committed so a result can be
# traced back to the exact weights that produced it.
#
# ⚠ GIT LFS IS REQUIRED. GitHub hard-rejects any single file >100MB, and the
#   Stage-2/3 LoRA adapters are ~245MB each (128.5M params in bf16). Run once:
#       git lfs install && git add .gitattributes
#   .gitattributes already routes *.safetensors / *.pt / *.bin / *.pth to LFS.
#   Without LFS the push WILL be rejected.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Checkpoints
checkpoints/
checkpoints/**

# Scratch / intermediates that are regenerated, never results
processed_data/
processed_graph/
stepmodel-final-v2/core/.llm_judge_cache
*.tmp
*.bak

# ---------------------------------------------------------------------------
# EXPLICITLY TRACKED (negated so no parent rule can silently drop them)
# ---------------------------------------------------------------------------
!output/
!output/**
!logs/
!logs/**
!*.log
