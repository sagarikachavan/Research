# Git LFS — required: GitHub rejects files >100MB and the Stage-2/3 LoRA
# adapters are ~245MB each. Run `git lfs install` once before committing.
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.bin         filter=lfs diff=lfs merge=lfs -text
*.ckpt        filter=lfs diff=lfs merge=lfs -text

# tokenizer.json is ~11MB and duplicated in every checkpoint dir; LFS
# de-duplicates identical blobs and keeps them out of the git object store.
tokenizer.json filter=lfs diff=lfs merge=lfs -text

# Results stay as normal git objects: they are small, and diffable history is
# the whole point of tracking them.
*.csv  -filter -diff -merge text
*.json -filter -diff -merge text
*.md   text
