{
  "model": {
    "llm_name": "Qwen/Qwen3-14B",
    "trust_remote_code": true,
    "text_embedding_model": "all-MiniLM-L6-v2",
    "gnn_hidden_dim": 256,
    "gnn_out_dim": 128,
    "use_gat": false
  },
  "training": {
    "num_supervised_epochs": 5,
    "num_grpo_epochs": 10,
    "batch_size": 1,
    "learning_rate": 3e-5,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "num_warmup_steps": 200,
    "num_generations_per_sample": 4,
    "clip_eps": 0.2,
    "generate_max_new_tokens": 768,
    "generate_temperature": 0.8,
    "generate_top_p": 0.95,
    "validation_split": 0.1,
    "patience": 5,
    "max_seq_length": 1024,
    "step_loss_weight": 1.0,
    "mcp_loss_weight": 1.5
  },
  "paths": {
    "data_dir": "data",
    "embeddings_dir": "embeddings_data",
    "output_dir": "checkpoints",
    "log_dir": "logs"
  }
}
