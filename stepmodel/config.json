{
  "model": {
    "llm_name": "Qwen/Qwen2.5-7B",
    "trust_remote_code": true,
    "load_in_4bit": false,
    "use_lora": true,
    "lora_r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.1,
    "lora_target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ],
    "torch_dtype": "bfloat16",
    "text_embedding_model": "all-MiniLM-L6-v2",
    "gnn_hidden_dim": 256,
    "gnn_out_dim": 128,
    "gnn_type": "gcn",
    "use_gat": false,
    "graph_token_count": 6,
    "pooling_strategy": "hybrid"
  },
  "training": {
    "num_supervised_epochs": 12,
    "num_grpo_epochs": 15,
    "batch_size": 1,
    "learning_rate": 2e-5,
    "weight_decay": 0.02,
    "max_grad_norm": 0.5,
    "num_warmup_steps": 300,
    "num_generations_per_sample": 6,
    "clip_eps": 0.15,
    "generate_max_new_tokens": 768,
    "generate_temperature": 0.7,
    "generate_top_p": 0.9,
    "validation_split": 0.1,
    "patience": 7,
    "max_seq_length": 512,
    "step_loss_weight": 2.0,
    "mcp_loss_weight": 1.8,
    "rl_aux_supervised_weight": 0.15,
    "prompt_style": "compact",
    "step_class_weighting": true,
    "step_class_weight_power": 0.7,
    "max_step_class_weight": 5.0,
    "mcp_class_weighting": true,
    "mcp_class_weight_power": 0.5,
    "max_mcp_class_weight": 8.0,
    "use_weighted_sampler": true,
    "sampler_power": 1.5,
    "selection_step_weight": 0.8,
    "selection_mcp_weight": 0.2,
    "selection_both_exact_weight": 0.05
  },
  "paths": {
    "data_dir": "data",
    "embeddings_dir": "embeddings_data",
    "output_dir": "checkpoints",
    "log_dir": "logs"
  }
}
