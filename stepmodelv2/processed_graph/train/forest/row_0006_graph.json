    },
    {
      "id": "finding:forest:r6:1.7.2",
      "label": "Finding 1.7.2\nElastic Security Solution, Sp…",
      "type": "Finding",
      "color": "#06D6A0",
      "status": null,
      "title": "Elastic Security Solution, Splunk, and HackTheBox provide security testing tools that can be used to exploit or mitigate the AS-REP Roasting vulnerability. These tools offer features like detection of vulnerable accounts, hash extraction, offline cracking, monitoring of suspicious activity, and regular audits and security assessments.",
      "size": 32,
